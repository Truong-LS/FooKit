# Database Configuration
# Yêu cầu mật khẩu mạnh (ít nhất 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt)
DB_PASSWORD=YourStrong@Password123!

# JWT Configuration
JWT_SECRET=super_secret_key_change_me_in_production_super_secret_key_change_me_in_production
JWT_ISSUER=FooKitIssuer
JWT_AUDIENCE=FooKitAudience
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# PayOS Configuration
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here
PAYOS_RETURN_URL=http://localhost:3000/payment/result
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel

# Accesstrade Affiliate Configuration
ACCESSTRADE_ACCESS_KEY=your_accesstrade_key_here

# Spoonacular Configuration
SPOONACULAR_API_KEY=your_spoonacular_key_here
SPOONACULAR_BASE_URL=https://api.spoonacular.com

# Gemini Configuration
GEMINI_API_KEY=your_gemini_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-1.5-flash
